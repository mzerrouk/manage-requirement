<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Tree View -->
    <record id="view_project_tree" model="ir.ui.view">
        <field name="name">requirement.project.tree</field>
        <field name="model">requirement.project</field>
        <field name="arch" type="xml">
            <list string="Projects">
                <field name="name"/>
                <field name="description"/>
                <field name="requirement_count"/>
            </list>
        </field>
    </record>

    <!-- Project Form View -->
    <record id="view_project_form" model="ir.ui.view">
        <field name="name">requirement.project.form</field>
        <field name="model">requirement.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_requirements" icon="fa-tasks" invisible="requirement_count == 0">
                            <field name="requirement_count" widget="statinfo" string="Requirements"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Enter project description..."/>
                        </page>
                        <page string="Requirements">
                            <field name="requirement_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="status" widget="badge"/>
                                    <field name="owner_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Project Action -->
    <record id="action_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">requirement.project</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first project
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_project" name="Projects" parent="menu_requirement_root" action="action_project" sequence="40"/>
</odoo>

