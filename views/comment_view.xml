<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Comment Tree View -->
    <record id="view_comment_tree" model="ir.ui.view">
        <field name="name">requirement.comment.tree</field>
        <field name="model">requirement.comment</field>
        <field name="arch" type="xml">
            <list string="Comments">
                <field name="user_id"/>
                <field name="requirement_id"/>
                <field name="change_id"/>
                <field name="content"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <!-- Comment Form View -->
    <record id="view_comment_form" model="ir.ui.view">
        <field name="name">requirement.comment.form</field>
        <field name="model">requirement.comment</field>
        <field name="arch" type="xml">
            <form string="Comment">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="requirement_id"/>
                            <field name="change_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="content" placeholder="Enter your comment..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Comment Action -->
    <record id="action_comment" model="ir.actions.act_window">
        <field name="name">Comments</field>
        <field name="res_model">requirement.comment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No comments yet
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_comment" name="Comments" parent="menu_requirement_root" action="action_comment" sequence="30"/>
</odoo>

