<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirement Tree View -->
    <record id="view_requirement_tree" model="ir.ui.view">
        <field name="name">requirement.requirement.tree</field>
        <field name="model">requirement.requirement</field>
        <field name="arch" type="xml">
            <list string="Requirements">
                <field name="name"/>
                <field name="type"/>
                <field name="priority" widget="priority"/>
                <field name="status" widget="badge" decoration-success="status == 'done'" decoration-info="status == 'approved'" decoration-warning="status == 'in_progress'" decoration-danger="status == 'rejected'"/>
                <field name="owner_id"/>
                <field name="project_id"/>
                <field name="created_date"/>
            </list>
        </field>
    </record>

    <!-- Requirement Form View -->
    <record id="view_requirement_form" model="ir.ui.view">
        <field name="name">requirement.requirement.form</field>
        <field name="model">requirement.requirement</field>
        <field name="arch" type="xml">
            <form string="Requirement">
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_children" icon="fa-sitemap" invisible="child_count == 0">
                            <field name="child_count" widget="statinfo" string="Sub-Requirements"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_changes" icon="fa-exchange" invisible="change_count == 0">
                            <field name="change_count" widget="statinfo" string="Changes"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_comments" icon="fa-comments" invisible="comment_count == 0">
                            <field name="comment_count" widget="statinfo" string="Comments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="priority" widget="priority"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="parent_id" domain="[('id', '!=', id)]"/>
                            <field name="created_date"/>
                            <field name="modified_date"/>
                            <field name="total_change_cost" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Enter requirement description..."/>
                        </page>
                        <page string="Sub-Requirements">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="status" widget="badge"/>
                                    <field name="owner_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Changes">
                            <field name="change_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="change_type"/>
                                    <field name="status" widget="badge"/>
                                    <field name="requested_by"/>
                                    <field name="request_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comments">
                            <field name="comment_ids">
                                <list>
                                    <field name="user_id"/>
                                    <field name="content"/>
                                    <field name="date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Requirement Kanban View -->
    <record id="view_requirement_kanban" model="ir.ui.view">
        <field name="name">requirement.requirement.kanban</field>
        <field name="model">requirement.requirement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <field name="name"/>
                <field name="type"/>
                <field name="priority"/>
                <field name="status"/>
                <field name="owner_id"/>
                <field name="project_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                    <span class="badge badge-pill" t-att-class="{'badge-danger': record.priority.raw_value == 'critical', 'badge-warning': record.priority.raw_value == 'high', 'badge-info': record.priority.raw_value == 'medium', 'badge-secondary': record.priority.raw_value == 'low'}">
                                        <field name="priority"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="type" widget="badge"/>
                                    <field name="project_id" invisible="not project_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="owner_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Requirement Search View -->
    <record id="view_requirement_search" model="ir.ui.view">
        <field name="name">requirement.requirement.search</field>
        <field name="model">requirement.requirement</field>
        <field name="arch" type="xml">
            <search string="Requirements">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="project_id"/>
                <filter string="My Requirements" name="my_requirements" domain="[('owner_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('status', '=', 'approved')]"/>
                <filter string="In Progress" name="in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('status', '=', 'done')]"/>
                <separator/>
                <filter string="Critical" name="critical" domain="[('priority', '=', 'critical')]"/>
                <filter string="High" name="high" domain="[('priority', '=', 'high')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type'}"/>
                    <filter string="Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Requirement Action -->
    <record id="action_requirement" model="ir.actions.act_window">
        <field name="name">Requirements</field>
        <field name="res_model">requirement.requirement</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_my_requirements': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first requirement
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_requirement_root" name="Requirements" sequence="10"/>
    <menuitem id="menu_requirement_main" name="Requirements" parent="menu_requirement_root" action="action_requirement" sequence="10"/>
</odoo>
