<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirement Change Tree View -->
    <record id="view_requirement_change_tree" model="ir.ui.view">
        <field name="name">requirement.change.tree</field>
        <field name="model">requirement.change</field>
        <field name="arch" type="xml">
            <list string="Change Requests">
                <field name="name"/>
                <field name="requirement_id"/>
                <field name="change_type"/>
                <field name="status" widget="badge" decoration-success="status == 'approved'" decoration-warning="status == 'pending'" decoration-danger="status == 'rejected'"/>
                <field name="requested_by"/>
                <field name="approved_by"/>
                <field name="additional_cost" sum="Total Cost"/>
                <field name="cost_approved"/>
                <field name="request_date"/>
            </list>
        </field>
    </record>

    <!-- Requirement Change Form View -->
    <record id="view_requirement_change_form" model="ir.ui.view">
        <field name="name">requirement.change.form</field>
        <field name="model">requirement.change</field>
        <field name="arch" type="xml">
            <form string="Change Request">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="status != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="status != 'pending'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="requirement_id"/>
                            <field name="change_type"/>
                        </group>
                        <group>
                            <field name="requested_by"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="request_date"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the change request..."/>
                        </page>
                        <page string="Comments">
                            <field name="comment_ids">
                                <list>
                                    <field name="user_id"/>
                                    <field name="content"/>
                                    <field name="date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cost Tracking">
                            <group>
                                <field name="additional_cost"/>
                                <field name="cost_approved"/>
                                <field name="cost_justification" placeholder="Explain the reason for additional cost..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Requirement Change Search View -->
    <record id="view_requirement_change_search" model="ir.ui.view">
        <field name="name">requirement.change.search</field>
        <field name="model">requirement.change</field>
        <field name="arch" type="xml">
            <search string="Change Requests">
                <field name="requirement_id"/>
                <field name="requested_by"/>
                <filter string="My Requests" name="my_requests" domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('status', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('status', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Change Type" name="group_type" context="{'group_by': 'change_type'}"/>
                    <filter string="Requirement" name="group_requirement" context="{'group_by': 'requirement_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Requirement Change Action -->
    <record id="action_requirement_change" model="ir.actions.act_window">
        <field name="name">Change Requests</field>
        <field name="res_model">requirement.change</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a change request
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_requirement_change" name="Change Requests" parent="menu_requirement_root" action="action_requirement_change" sequence="20"/>
</odoo>

