<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice List View -->
    <record id="view_requirement_invoice_list" model="ir.ui.view">
        <field name="name">requirement.invoice.list</field>
        <field name="model">requirement.invoice</field>
        <field name="arch" type="xml">
            <list string="Invoices">
                <field name="name"/>
                <field name="date"/>
                <field name="project_id"/>
                <field name="total_cost" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- Invoice Form View -->
    <record id="view_requirement_invoice_form" model="ir.ui.view">
        <field name="name">requirement.invoice.form</field>
        <field name="model">requirement.invoice</field>
        <field name="arch" type="xml">
            <form string="Invoice">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="total_cost" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requirements">
                            <field name="requirement_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="status"/>
                                    <field name="total_change_cost" sum="Total Cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Invoice Search View -->
    <record id="view_requirement_invoice_search" model="ir.ui.view">
        <field name="name">requirement.invoice.search</field>
        <field name="model">requirement.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Invoices">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <filter string="This Month" name="this_month" 
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                ('date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Invoice Action -->
    <record id="action_requirement_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">requirement.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first invoice
            </p>
            <p>
                Export requirements with total costs from approved change requests.
            </p>
        </field>
    </record>

    <!-- Menu Item in QAT (Quick Access Toolbar) -->
    <menuitem id="menu_requirement_invoice"
              name="Invoices"
              parent="menu_requirement_root"
              action="action_requirement_invoice"
              sequence="50"/>
</odoo>
